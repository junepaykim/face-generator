# Python
.venv/
# uv, installed here by Start.bat when it is not on PATH
/.bin/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# Rust build output (native/); Cargo.lock stays tracked
native/target/

# Runtime state and generated pictures
/data/

# Game files and model weights never belong in the repository
*.fm
*.safetensors
*.ckpt
*.gguf
models/
# ... but not the README's sample pictures of each model (AGENTS.md rule 7)
!docs/images/models/

# This PC's own paths (holds the Windows user name)
config/local.toml

# Design docs stay on this PC; only the README's sample pictures are published
docs/*.md
